# Copie para .env e ajuste conforme necessário
# Não é necessário para uso com kubeconfig upload — preenchido automaticamente

# Opcional: região AWS padrão (o backend detecta do kubeconfig)
AWS_DEFAULT_REGION=us-east-1

# Porta do backend
BACKEND_PORT=8000

# URL do backend (usada pelo frontend)
VITE_API_URL=http://localhost:8000
